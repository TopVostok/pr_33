<Page x:Class="ChatStudents.Pages.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ChatStudents.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Main">

    <Grid>
        <!-- Верхняя панель (шапка) -->
        <Grid Background="#FF0071FF" Height="50" VerticalAlignment="Top">
            <Image Margin="10" Width="30" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Source="/Images/i.webp"/>
            <Label Content="Чат Students" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="50, 5, 0, 0" Foreground="White" FontWeight="Bold" FontSize="20"/>
        </Grid>

        <!-- Основное содержимое -->
        <Grid Margin="0, 50, 0, 0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель - список пользователей -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F5F5F5">
                <StackPanel x:Name="ParentUsers">
                    <!-- Здесь будут отображаться пользователи -->
                </StackPanel>
            </ScrollViewer>

            <!-- Правая панель - область чата -->
            <Grid Grid.Column="1" x:Name="Chat" Visibility="Visible" Background="White">
                <!-- Верхняя часть чата с информацией о собеседнике -->
                <Grid Height="50" VerticalAlignment="Top" Background="#E8E8E8">
                    <Image x:Name="imgUser" Margin="10, 0, 0, 0" Width="30" Height="30" HorizontalAlignment="Left" 
                           Source="/Images/i.webp">
                        <Image.Clip>
                            <RectangleGeometry RadiusX="15" RadiusY="15" Rect="0,0,30,30"/>
                        </Image.Clip>
                    </Image>
                    <Image Width="10" Height="10" Margin="30, 30, 0, 0" HorizontalAlignment="Left" 
                           Source="C:\Users\student-a502.PERMAVIAT\Desktop\ChatStudents\Images\ic-online.avif" Visibility="Visible"/>
                    <Label x:Name="FIO" Content="Выберите собеседника" Margin="45, 0, 0, 0" 
                           VerticalAlignment="Top" FontWeight="Bold" FontSize="14"/>
                </Grid>

                <!-- Область сообщений -->
                <ScrollViewer Margin="0,50,0,50" x:Name="MessagesScrollViewer">
                    <StackPanel x:Name="ParentMessages">
                        <!-- Здесь будут отображаться сообщения -->
                    </StackPanel>
                </ScrollViewer>

                <!-- Поле ввода сообщения -->
                <TextBox x:Name="Message" Height="35" VerticalContentAlignment="Center" 
                         Margin="10,0,10,10" TextWrapping="Wrap" 
                         VerticalAlignment="Bottom" Grid.Column="1"
                         KeyUp="SendMessage"
                         Background="#F0F0F0"
                         BorderBrush="#CCCCCC"
                         BorderThickness="1"/>
            </Grid>
        </Grid>
    </Grid>
</Page>